# ---------------------------------------------------------------------------
# Copia este archivo como .env.local y rellena los valores reales.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Si tu proyecto todavía muestra la llave "anon" (formato JWT), pégala aquí igual:
# la app acepta cualquiera de las dos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# OJO: sin el prefijo NEXT_PUBLIC_. Ese prefijo es lo que hace que Next meta la
# variable en el código que se manda al navegador, y esta llave se salta RLS
# entera: publicarla es dar acceso total a la base. Solo la usa el servidor,
# para registrar los pedidos (utils/supabase/admin.ts).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp del restaurante, en formato internacional y SIN el signo +
NEXT_PUBLIC_WHATSAPP_NUMBER=573137604265

# URL pública del sitio. Solo hace falta si cambias de dominio o quieres que un
# deploy de preview se anuncie a sí mismo. Por defecto se usa `site.url` de
# lib/site.ts (https://mesondecarmen.com), que es lo que consumen el sitemap,
# los canonical y los datos estructurados.
# NEXT_PUBLIC_SITE_URL=https://mesondecarmen.com
